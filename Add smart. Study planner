<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Study Planner</title>
<style>
:root {
  --blue: #2457d6;
  --dark: #172b4d;
  --bg: #f4f7fc;
  --white: #ffffff;
  --muted: #68758b;
  --border: #e2e8f2;
  --green: #14845b;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--dark);
}
header {
  background: linear-gradient(120deg, #173d9b, #3978f6);
  color: white;
  padding: 27px 6%;
}
header h1 { margin: 0 0 8px; font-size: 28px; }
header p { margin: 0; opacity: .9; }
main { max-width: 1100px; margin: 28px auto; padding: 0 18px; }
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-bottom: 22px;
}
.card, .panel {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  box-shadow: 0 4px 18px #19366c0a;
}
.stat-label { color: var(--muted); font-size: 14px; }
.stat-number { font-size: 29px; font-weight: bold; margin-top: 10px; }
.panel { margin-bottom: 20px; }
h2 { font-size: 19px; margin: 0 0 18px; }
form .fields {
  display: grid;
  grid-template-columns: 2fr 1.3fr 1.2fr 1fr;
  gap: 12px;
}
label { display: block; font-size: 13px; margin-bottom: 7px; color: var(--muted); }
input, select {
  width: 100%;
  min-width: 0;
  padding: 11px;
  border: 1px solid #ccd6e5;
  border-radius: 8px;
  font: inherit;
  background: white;
  color: var(--dark);
}
input:focus, select:focus { outline: 2px solid #a9c5ff; }
button {
  cursor: pointer;
  border: 0;
  border-radius: 8px;
  padding: 11px 15px;
  font-weight: bold;
  font-size: 14px;
}
.primary { background: var(--blue); color: white; }
.secondary { background: #eaf0ff; color: var(--blue); }
.danger { background: #fff0f0; color: #c52c3c; }
.form-actions { margin-top: 15px; display: flex; gap: 8px; }
.progress-track {
  height: 9px;
  border-radius: 10px;
  background: #e7edf6;
  overflow: hidden;
  margin-top: 12px;
}
.progress-fill {
  height: 100%;
  width: 0;
  background: var(--green);
  transition: width .2s;
}
.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 16px;
}
.toolbar select { max-width: 190px; }
.task-list { display: grid; gap: 10px; }
.task {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  padding: 14px;
  border-radius: 10px;
}
.task.done .task-name {
  text-decoration: line-through;
  color: var(--muted);
}
.task-check { width: 19px; height: 19px; flex-shrink: 0; }
.task-info { flex: 1; min-width: 0; }
.task-name { font-weight: bold; overflow-wrap: anywhere; }
.meta { font-size: 12px; color: var(--muted); margin-top: 6px; }
.tag {
  display: inline-block;
  font-size: 11px;
  border-radius: 20px;
  padding: 4px 8px;
  background: #eaf0ff;
  color: var(--blue);
  margin-top: 7px;
}
.task-buttons { display: flex; gap: 6px; }
.task-buttons button { padding: 8px 10px; }
.empty { text-align: center; color: var(--muted); padding: 28px 5px; }
.timer { text-align: center; }
.clock { font-size: 46px; font-weight: bold; margin: 10px 0 18px; }
.timer-buttons { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
footer { text-align: center; color: var(--muted); padding: 24px; font-size: 13px; }
@media (max-width: 720px) {
  .stats { grid-template-columns: 1fr; }
  form .fields { grid-template-columns: 1fr 1fr; }
  .toolbar { align-items: stretch; flex-direction: column; }
  .toolbar select { max-width: none; }
  .task { flex-wrap: wrap; }
  .task-buttons { width: 100%; padding-left: 30px; }
}
@media (max-width: 430px) {
  form .fields { grid-template-columns: 1fr; }
  header h1 { font-size: 24px; }
  .clock { font-size: 38px; }
}
</style>
</head>
<body>
<header>
  <h1>📚 Smart Study Planner</h1>
  <p>Plan your day, focus on your goals, and track your progress.</p>
</header>

<main>
  <section class="stats">
    <div class="card">
      <div class="stat-label">Total Tasks</div>
      <div class="stat-number" id="total">0</div>
    </div>
    <div class="card">
      <div class="stat-label">Completed Tasks</div>
      <div class="stat-number" id="completed">0</div>
    </div>
    <div class="card">
      <div class="stat-label">Study Progress</div>
      <div class="stat-number" id="percentage">0%</div>
      <div class="progress-track">
        <div class="progress-fill" id="progress"></div>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2 id="formTitle">➕ Add a Study Task</h2>
    <form id="taskForm">
      <div class="fields">
        <div>
          <label for="taskName">Task or Topic</label>
          <input id="taskName" maxlength="120" placeholder="e.g. Study Linear Algebra" required>
        </div>
        <div>
          <label for="subject">Subject</label>
          <input id="subject" maxlength="60" placeholder="e.g. Mathematics" required>
        </div>
        <div>
          <label for="date">Study Date</label>
          <input id="date" type="date" required>
        </div>
        <div>
          <label for="priority">Priority</label>
          <select id="priority">
            <option>Medium</option>
            <option>High</option>
            <option>Low</option>
          </select>
        </div>
      </div>
      <div class="form-actions">
        <button class="primary" type="submit" id="saveButton">Add Task</button>
        <button class="secondary" type="button" id="cancelButton" hidden>Cancel Edit</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <div class="toolbar">
      <h2 style="margin:0">📝 My Study Tasks</h2>
      <select id="filter" aria-label="Filter tasks">
        <option value="all">All Tasks</option>
        <option value="pending">Pending Tasks</option>
        <option value="done">Completed Tasks</option>
      </select>
    </div>
    <div id="taskList" class="task-list"></div>
  </section>

  <section class="panel timer">
    <h2>⏱️ Focus Timer</h2>
    <p>Focus on one task at a time. Take a break when the timer ends.</p>
    <div class="clock" id="clock">25:00</div>
    <div class="timer-buttons">
      <button class="primary" id="startTimer">Start</button>
      <button class="secondary" id="pauseTimer">Pause</button>
      <button class="secondary" id="resetTimer">Reset</button>
      <button class="secondary" id="breakTimer">5-Minute Break</button>
    </div>
  </section>

  <section class="panel">
    <h2>💾 Data & Privacy</h2>
    <p style="color:#68758b;font-size:14px;line-height:1.6">
      Your tasks are saved in this browser on this device. This basic version
      does not use an AI service or a remote database.
    </p>
    <button class="danger" id="clearData">Delete All Tasks</button>
  </section>
</main>

<footer>Smart Study Planner · Build good habits, one day at a time.</footer>

<script>
const $ = id => document.getElementById(id);
const STORAGE_KEY = "smartStudyPlannerTasksV1";
let tasks = [];
let editingId = null;
let remaining = 25 * 60;
let timerInterval = null;

try {
  const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
  tasks = Array.isArray(saved) ? saved.filter(t =>
    t && typeof t.id === "string" &&
    typeof t.name === "string" &&
    typeof t.subject === "string" &&
    typeof t.date === "string" &&
    typeof t.done === "boolean"
  ) : [];
} catch {
  tasks = [];
}

function saveTasks() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
  } catch {
    alert("Could not save data. Please check your browser storage settings.");
  }
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, ch => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;",
    '"': "&quot;", "'": "&#39;"
  })[ch]);
}

function render() {
  const doneCount = tasks.filter(t => t.done).length;
  const pct = tasks.length ? Math.round(doneCount / tasks.length * 100) : 0;
  $("total").textContent = tasks.length;
  $("completed").textContent = doneCount;
  $("percentage").textContent = pct + "%";
  $("progress").style.width = pct + "%";

  const filter = $("filter").value;
  const visible = tasks.filter(t =>
    filter === "all" ||
    (filter === "pending" && !t.done) ||
    (filter === "done" && t.done)
  ).sort((a, b) => a.date.localeCompare(b.date));

  if (!visible.length) {
    $("taskList").innerHTML =
      '<div class="empty">No tasks here yet. Add your first study task above!</div>';
    return;
  }

  $("taskList").innerHTML = visible.map(t => `
    <article class="task ${t.done ? "done" : ""}">
      <input class="task-check" type="checkbox"
        data-action="toggle" data-id="${escapeHTML(t.id)}"
        ${t.done ? "checked" : ""} aria-label="Mark task complete">
      <div class="task-info">
        <div class="task-name">${escapeHTML(t.name)}</div>
        <div class="meta">${escapeHTML(t.subject)} · ${escapeHTML(t.date)}</div>
        <span class="tag">${escapeHTML(t.priority || "Medium")} Priority</span>
      </div>
      <div class="task-buttons">
        <button class="secondary" data-action="edit"
          data-id="${escapeHTML(t.id)}">Edit</button>
        <button class="danger" data-action="delete"
          data-id="${escapeHTML(t.id)}">Delete</button>
      </div>
    </article>
  `).join("");
}

function resetForm() {
  editingId = null;
  $("taskForm").reset();
  $("date").value = new Date().toLocaleDateString("en-CA");
  $("formTitle").textContent = "➕ Add a Study Task";
  $("saveButton").textContent = "Add Task";
  $("cancelButton").hidden = true;
}

$("taskForm").addEventListener("submit", event => {
  event.preventDefault();
  const name = $("taskName").value.trim();
  const subject = $("subject").value.trim();
  const date = $("date").value;
  if (!name || !subject || !date) return;

  const priority = $("priority").value;
  if (editingId) {
    tasks = tasks.map(t => t.id === editingId
      ? { ...t, name, subject, date, priority }
      : t);
  } else {
    tasks.push({
      id: crypto.randomUUID ? crypto.randomUUID() :
        Date.now().toString(36) + Math.random().toString(36).slice(2),
      name, subject, date, priority, done: false
    });
  }
  saveTasks();
  resetForm();
  render();
});

$("cancelButton").addEventListener("click", resetForm);
$("filter").addEventListener("change", render);

$("taskList").addEventListener("click", event => {
  const button = event.target.closest("button[data-action]");
  if (!button) return;
  const id = button.dataset.id;
  const action = button.dataset.action;
  const task = tasks.find(t => t.id === id);
  if (!task) return;

  if (action === "edit") {
    editingId = id;
    $("taskName").value = task.name;
    $("subject").value = task.subject;
    $("date").value = task.date;
    $("priority").value = task.priority || "Medium";
    $("formTitle").textContent = "✏️ Edit Study Task";
    $("saveButton").textContent = "Save Changes";
    $("cancelButton").hidden = false;
    $("taskName").focus();
  }

  if (action === "delete" &&
      confirm("Are you sure you want to delete this task?")) {
    tasks = tasks.filter(t => t.id !== id);
    if (editingId === id) resetForm();
    saveTasks();
    render();
  }
});

$("taskList").addEventListener("change", event => {
  const checkbox = event.target;
  if (!checkbox.matches('input[data-action="toggle"]')) return;
  const id = checkbox.dataset.id;
  tasks = tasks.map(t => t.id === id
    ? { ...t, done: checkbox.checked }
    : t);
  saveTasks();
  render();
});

$("clearData").addEventListener("click", () => {
  if (!confirm("Delete all study tasks? This cannot be undone.")) return;
  tasks = [];
  saveTasks();
  resetForm();
  render();
});

function displayClock() {
  const mins = Math.floor(remaining / 60);
  const secs = remaining % 60;
  $("clock").textContent =
    String(mins).padStart(2, "0") + ":" +
    String(secs).padStart(2, "0");
}

function stopTimer() {
  if (timerInterval !== null) clearInterval(timerInterval);
  timerInterval = null;
}

function startCountdown() {
  if (timerInterval !== null) return;
  timerInterval = setInterval(() => {
    remaining--;
    displayClock();
    if (remaining <= 0) {
      stopTimer();
      remaining = 0;
      displayClock();
      alert("Timer finished! Take a moment to rest.");
    }
  }, 1000);
}

$("startTimer").addEventListener("click", startCountdown);
$("pauseTimer").addEventListener("click", stopTimer);
$("resetTimer").addEventListener("click", () => {
  stopTimer();
  remaining = 25 * 60;
  displayClock();
});
$("breakTimer").addEventListener("click", () => {
  stopTimer();
  remaining = 5 * 60;
  displayClock();
  startCountdown();
});

resetForm();
displayClock();
render();
</script>
</body>
</html>
